# Copie este arquivo para .env e ajuste os valores.
# Ambientes: development | homologacao | production
NODE_ENV=development
PORT=3000
# Endereço público usado nos links de convite e redefinição de senha
BASE_URL=http://localhost:3000
# Defina como true quando o sistema estiver atrás de um proxy reverso (Nginx, Caddy, IIS) que faz o HTTPS
TRUST_PROXY=false

# Banco e arquivos (caminhos relativos à pasta do projeto)
DB_FILE=storage/prismati.db
STORAGE_DIR=storage
BACKUP_DIR=backups

# Primeiro administrador (criado na primeira execução se ainda não existir)
ADMIN_EMAIL=admin@suaempresa.com.br
ADMIN_PASSWORD=TroqueEstaSenha123
ADMIN_NAME=Administrador PrismaTI
# Verificação em duas etapas obrigatória para administradores (padrão: true em produção)
# ADMIN_MFA_REQUIRED=true
# Permite que o administrador veja respostas e evidências das empresas (padrão: false)
ADMIN_CAN_VIEW_ANSWERS=false

# Sessão e links
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
INVITE_EXPIRES_HOURS=72
RESET_EXPIRES_MINUTES=30

# Limites de requisição
RATE_LOGIN_PER_15MIN=10
RATE_TOKEN_PER_15MIN=20
RATE_API_PER_MIN=600

# Evidências
UPLOAD_MAX_MB=5
UPLOAD_MAX_PER_ANSWER=5

# E-mail. Sem SMTP_URL, os e-mails são gravados em storage/outbox e o admin vê o link de convite na tela.
# Exemplo: smtps://usuario:senha@smtp.seuprovedor.com:465
SMTP_URL=
MAIL_FROM=PrismaTI <nao-responda@prismati.com.br>

# Relatórios por IA. Sem chave, um gerador local (sem IA externa) produz o relatório.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=high
AI_MAX_OUTPUT_TOKENS=32000
AI_MAX_ATTEMPTS=3
AI_MONTHLY_REPORTS_PER_COMPANY=10
AI_MONTHLY_TOKENS_PER_COMPANY=2000000
AI_MONTHLY_TOKENS_GLOBAL=20000000
# Preço em US$ por milhão de tokens, usado na estimativa de custo
AI_PRICE_INPUT_PER_MTOK=4
AI_PRICE_OUTPUT_PER_MTOK=20
